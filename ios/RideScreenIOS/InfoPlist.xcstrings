{
  "sourceLanguage": "es",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen usa tu ubicación mientras grabas un trayecto para calcular la distancia y la velocidad."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen utilitza la teva ubicació mentre graves un trajecte per calcular la distància i la velocitat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen uses your location while recording a trip to calculate distance and speed."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen necesita tu ubicación en segundo plano para continuar grabando el trayecto cuando bloqueas el iPhone. Solo se usa durante una grabación activa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen necessita la teva ubicació en segon pla per continuar gravant el trajecte quan bloqueges l'iPhone. Només s'utilitza durant una gravació activa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen needs background location to keep recording a trip when you lock your iPhone. It is used only during an active recording."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen usa Bluetooth para leer la batería y controlar la caja PKE de tu moto cuando lo solicitas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen fa servir el Bluetooth per llegir la bateria i controlar la caixa PKE de la teva moto quan ho demanes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen uses Bluetooth to read the battery and control your bike's PKE box when you ask it to."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen se conecta a la pantalla de tu moto a través de su Wi‑Fi para enviarle la imagen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen es connecta a la pantalla de la moto a través del seu Wi‑Fi per enviar-li la imatge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen connects to your bike's display over its Wi‑Fi to send it the picture."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen usa la cámara para leer el código QR de la pantalla de tu moto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen fa servir la càmera per llegir el codi QR de la pantalla de la moto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen uses the camera to read the QR code on your bike's display."
          }
        }
      }
    }
  },
  "version": "1.0"
}
