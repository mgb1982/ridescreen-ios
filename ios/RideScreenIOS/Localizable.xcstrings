          }
        }
      }
    },
    "trips.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus trayectos grabados aparecerán aquí. Puedes exportar cualquiera de ellos a GPX."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els trajectes que gravis apareixeran aquí. Pots exportar-los a GPX."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded trips will appear here. You can export any trip as GPX."
          }
        }
      }
    },
