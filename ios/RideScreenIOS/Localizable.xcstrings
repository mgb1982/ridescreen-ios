    "dash.image.step": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen propia en el cuadro (móvil bloqueado)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Imatge pròpia al quadre (mòbil bloquejat)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Own picture on the dash (phone locked)"
          }
        }
      }
    },
    "dash.image.body": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el Wi‑Fi de la moto conectado y la app de Android cerrada, pulsa Iniciar. El cuadro mostrará un mapa que gira y se mueve contigo. Si eliges un destino, verás la ruta y la próxima maniobra. Bloquea el iPhone y comprueba que el mapa sigue moviéndose. Después comparte el registro."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb el Wi‑Fi de la moto connectat i l’app d’Android tancada, prem Inicia. El quadre mostrarà un mapa que gira i es mou amb tu. Si tries una destinació, veuràs la ruta i la propera maniobra. Bloqueja l’iPhone i comprova que el mapa continua movent-se. Després comparteix el registre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the bike's Wi‑Fi joined and the Android app closed, tap Start. The dash shows a map that turns and moves with you. Pick a destination to see the route and the next turn. Lock the iPhone and check the map keeps moving. Then share the log."
          }
        }
      }
    },
    "dash.image.start": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
