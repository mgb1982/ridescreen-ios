    "permission.when.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir ubicación mientras usas la app"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permetre la ubicació mentre fas servir l'app"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location while using the app"
          }
        }
      }
    },
    "permission.when.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu ubicación para grabar el trayecto, calcular la distancia y mostrar la velocidad. Primero solicitamos permiso solo mientras usas RideScreen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessitem la teva ubicació per gravar el trajecte, calcular la distància i mostrar la velocitat. Primer demanem permís només mentre fas servir RideScreen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your location to record the trip, calculate distance and show speed. First, we request access only while you use RideScreen."
          }
        }
      }
    },
    "permission.always.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir ubicación también en segundo plano"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permetre la ubicació també en segon pla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location in the background"
          }
        }
      }
    },
    "permission.always.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar grabando cuando bloquees el iPhone o cambies de app, RideScreen necesita permiso «Siempre». Solo se utiliza mientras la grabación está activa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuar gravant quan bloquegis l'iPhone o canviïs d'app, RideScreen necessita el permís «Sempre». Només s'utilitza mentre la gravació està activa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep recording when you lock your iPhone or switch apps, RideScreen needs “Always” access. It is used only while recording is active."
          }
        }
      }
    },
    "permission.always.allow": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir «Siempre»"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permetre «Sempre»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Always"
          }
        }
      }
    },
    "permission.always.foreground": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con la app abierta"
