          }
        }
      }
    },
    "permission.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso de ubicación necesario"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal el permís d'ubicació"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission required"
          }
        }
      }
    },
    "permission.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permiso de ubicación para poder grabar. Puedes cambiarlo en Ajustes de iOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permís d'ubicació per poder gravar. Pots canviar-lo als Ajustos d'iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location permission to record a trip. You can change it in iOS Settings."
          }
        }
      }
    },
    "permission.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrir Ajustos"
          }
        },
        "en": {
