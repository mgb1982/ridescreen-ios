    "record.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación durante la grabación"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva ubicació durant la gravació"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location while recording"
          }
        }
      }
    },
    "record.permission.explanation": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen usa el GPS para calcular la distancia, la velocidad y guardar el recorrido mientras grabas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen utilitza el GPS per calcular la distància, la velocitat i desar el recorregut mentre graves."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RideScreen uses GPS to calculate distance and speed and save the route while you record."
          }
        }
      }
    },
    "record.permission.always": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir grabando con la pantalla bloqueada, iOS te pedirá permiso «Siempre» después de que pulses Empezar. La ubicación solo se guarda durante un trayecto activo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuar gravant amb la pantalla bloquejada, iOS et demanarà el permís «Sempre» després que premis Començar. La ubicació només es desa durant un trajecte actiu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep recording while the screen is locked, iOS will ask for “Always” permission after you tap Start. Location is saved only during an active trip."
          }
        }
      }
    },
    "record.localOnly": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los trayectos y el diagnóstico se guardan únicamente en este iPhone. No se envían datos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els trajectes i el diagnòstic es desen només en aquest iPhone. No s'envien dades."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips and diagnostics stay on this iPhone. No data is sent."
          }
        }
      }
    },
