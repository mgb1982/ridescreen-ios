            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "permission.background.off.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación solo en primer plano"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravació només en primer pla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreground recording only"
          }
        }
      }
    },
    "permission.background.off.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido el permiso «Siempre». El trayecto se grabará mientras RideScreen esté abierta, pero puede detenerse al bloquear el iPhone o cambiar de app."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha concedit el permís «Sempre». El trajecte es gravarà mentre RideScreen estigui oberta, però pot aturar-se en bloquejar l'iPhone o canviar d'app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always” permission was not granted. The trip will record while RideScreen is open, but may stop when you lock the iPhone or switch apps."
          }
        }
      }
    },
    "permission.services.off.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios de ubicación desactivados"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveis d'ubicació desactivats"
