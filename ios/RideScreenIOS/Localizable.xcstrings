    "mirror.test.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la contraseña, ve a Ajustes › Wi‑Fi y conéctate a la red de arriba. Si el iPhone avisa de que no tiene internet, mantén la conexión. Luego vuelve aquí."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la contrasenya, ves a Configuració › Wi‑Fi i connecta’t a la xarxa de dalt. Si l’iPhone avisa que no té internet, mantén la connexió. Després torna aquí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the password, open Settings › Wi‑Fi and join the network above. If the iPhone warns there is no internet, stay connected. Then come back here."
          }
        }
      }
    },
