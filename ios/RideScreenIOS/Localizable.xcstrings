      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron %1$d puntos y %.2f km guardados. Puedes continuar grabando desde el último punto o descartar el trayecto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han trobat %1$d punts i %.2f km desats. Pots continuar gravant des de l'últim punt o descartar el trajecte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %1$d saved points and %.2f km. You can resume from the last point or discard the trip."
          }
        }
      }
    },
    "recovery.message.fallback": {
      "extractionState": "manual",
      "localizations": {
