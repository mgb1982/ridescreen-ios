          }
        }
      }
    },
    "permission.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso de ubicación necesario"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal el permís d'ubicació"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission required"
          }
        }
      }
    },
    "permission.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permiso de ubicación para poder grabar. Puedes cambiarlo en Ajustes de iOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permís d'ubicació per poder gravar. Pots canviar-lo als Ajustos d'iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location permission to record a trip. You can change it in iOS Settings."
          }
        }
      }
    },
    "permission.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrir Ajustos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "permission.background.off.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación solo en primer plano"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravació només en primer pla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreground recording only"
          }
        }
      }
    },
    "permission.background.off.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido el permiso «Siempre». El trayecto se grabará mientras RideScreen esté abierta, pero puede detenerse al bloquear el iPhone o cambiar de app."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha concedit el permís «Sempre». El trajecte es gravarà mentre RideScreen estigui oberta, però pot aturar-se en bloquejar l'iPhone o canviar d'app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always” permission was not granted. The trip will record while RideScreen is open, but may stop when you lock the iPhone or switch apps."
          }
        }
      }
    },
    "permission.services.off.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios de ubicación desactivados"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveis d'ubicació desactivats"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are off"
          }
        }
      }
    },
    "permission.services.off.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los servicios de ubicación en Ajustes de iOS para grabar un trayecto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa els serveis d'ubicació als Ajustos d'iOS per gravar un trajecte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Location Services in iOS Settings to record a trip."
          }
        }
      }
    },
    "recovery.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un trayecto interrumpido"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha un trajecte interromput"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted trip was found"
          }
        }
      }
    },
    "recovery.recover": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar trayecto"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar trajecte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover trip"
          }
        }
      }
    },
    "recovery.discard": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard"
          }
        }
      }
    },
    "recovery.message": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron %1$d puntos y %.2f km guardados. Puedes continuar grabando desde el último punto o descartar el trayecto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han trobat %1$d punts i %.2f km desats. Pots continuar gravant des de l'últim punt o descartar el trajecte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %1$d saved points and %.2f km. You can resume from the last point or discard the trip."
          }
        }
      }
    },
    "recovery.message.fallback": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes recuperar o descartar el trayecto guardado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots recuperar o descartar el trajecte desat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can recover or discard the saved trip."
          }
        }
      }
    },
    "trip.error.start": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el registro del trayecto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut iniciar el registre del trajecte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start trip recording."
          }
        }
      }
    },
    "trip.error.finish": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar y guardar el trayecto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut tancar i desar el trajecte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not finish and save the trip."
          }
        }
      }
    },
    "trip.error.recovery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recuperar el trayecto interrumpido."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut recuperar el trajecte interromput."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not recover the interrupted trip."
          }
        }
      }
    },
    "trip.error.discard": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descartar el trayecto interrumpido."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut descartar el trajecte interromput."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not discard the interrupted trip."
          }
        }
      }
    },
    "trip.error.export": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el archivo GPX."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut preparar el fitxer GPX."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the GPX file."
          }
        }
      }
    },
    "trip.error.persistence": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar un punto del trayecto. La grabación se ha detenido para evitar perder más datos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut desar un punt del trajecte. La gravació s'ha aturat per evitar perdre més dades."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip point could not be saved. Recording was stopped to avoid losing more data."
          }
        }
      }
    },
    "trips.header": {
      "extractionState": "manual",
